    "치치시리얼": {
      "source_permalink": {
        "value": "https://www.instagram.com/p/DZoF2_QTN1g/",
        "was": null,
        "at": "2026-08-09"
      },
      "official_texture": {
        "value": "리본비즈의 자극은 디폼 > 리본비즈 > 별비즈 순으로 느껴지고, 쟈글한 6디폼과 합이 좋아요. 초반에 늘일 때는 응집되어 있는 쁠루모 쩰리에 수정액을 한 숟가락 넣은 느낌이에요. 얇고 요거트 같은 베이스 사이로 재료가 버무려지고, 부풀수록 녹진함이 돌며 크리미로 꽉 찬 질감이 올라와요. 부풀어도 얇게 겹겹이 기포층이 쌓이는 느낌이어서 쟈글함이 잘 느껴져요. 코팅감이 아주 좋아요.",
        "was": null,
        "at": "2026-08-09"
      }
    },
    "크림꼬끄카롱": {
      "source_permalink": {
        "value": "https://www.instagram.com/p/DZjRbt_q90G/",
        "was": null,
        "at": "2026-08-09"
